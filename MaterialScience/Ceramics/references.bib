	date = {2011-09-06},
	langid = {english},
	file = {Full Text:/home/oel/Zotero/storage/I3UKYR2M/Kohara et al. - 2011 - Relationship between topological order and glass forming ability in densely packed enstatite and for.pdf:application/pdf},
