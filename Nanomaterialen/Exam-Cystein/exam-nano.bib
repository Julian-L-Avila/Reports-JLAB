@article{gonzalezNanoparticulasOroFuncionalizadas2022,
  title = {Nanopart\'iculas {{De Oro Funcionalizadas Con L-Ciste\'ina Para Detecci\'on De Ars\'enico En Agua}}},
  author = {Gonz{\'a}lez, Edgar E. and Acu{\~n}a, Yesid A. and Quiroz, Ana M.},
  year = 2022,
  month = may,
  journal = {Ingenier\'ia Investigaci\'on y Desarrollo},
  volume = {21},
  number = {2},
  pages = {66--72},
  issn = {2422-4324, 1900-771X},
  doi = {10.19053/1900771X.v21.n2.2021.14271},
  urldate = {2026-03-25},
  abstract = {En este art\'iculo se reportan resultados experimentales de interacciones del amino\'acido L-ciste\'ina (Cis) con nanopart\'iculas de oro (AuNPs) y nanopart\'iculas de oro funcionalizadas con Cis (AuNPs+Cis) cuando se incorpora en la soluci\'on iones de As3+. En los procesos de agregaci\'on se eval\'ua el papel de la concentraci\'on de la Cis en la funcionalizaci\'on, adem\'as del tama\~no de las nanopart\'iculas cuando se incorpora a la soluci\'on el agente i\'onico de inter\'es. Los resultados muestran una sensible dependencia en la agregaci\'on de las nanosondas AuNPs+Cis en funci\'on de su tama\~no, con un registro de mayor sensibilidad para nanopart\'iculas de mayor di\'ametro. Se observa que la concentraci\'on de la Cis en el proceso defuncionalizaci\'on es condici\'on necesaria para la programaci\'on de la estabilidad de las nanosondas, aspecto esencial paraconfigurar un modo estable para detecci\'on del agente i\'onico. De manera que, estos resultados permiten establecer criterios\'utiles para el dise\~no de sensores colorim\'etricos para detecci\'on de metales pesados en aguas contaminadas.},
  file = {/home/oel/Dokumente/Papers/González et al.2022 - Nanopartículas De Oro Funcionalizadas Con L-Cisteína Para Detección De Arsénico En Agua.pdf}
}
